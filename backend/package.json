{
  "name": "ai-assistant-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/server.ts",
    "build": "tsc --build",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src shared --ext .ts",
    "lint:fix": "eslint src shared --ext .ts --fix",
    "format": "prettier --write src shared",
    "format:check": "prettier --check src shared",
    "test": "jest",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/src/jest.setup.ts"],
    "roots": ["<rootDir>/src", "<rootDir>/shared"],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    }
  }
}
