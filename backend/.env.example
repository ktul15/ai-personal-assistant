# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ── Vector DB (Pinecone) ───────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
# Serverless indexes: use region only (e.g. us-east-1). Legacy pods: use us-east-1-aws.
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=assistant-memories

# ── Databases ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://assistant:your-db-password@localhost:5432/assistant
REDIS_URL=redis://:your-redis-password@localhost:6379
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=your-db-password
REDIS_PASSWORD=your-redis-password

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── Storage (AWS S3 / Cloudflare R2) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=assistant-audio

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
WEBSOCKET_PORT=3001
LOG_LEVEL=info
